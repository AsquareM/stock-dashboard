{
    "projectId": "69f58d76003dee022bc9",
    "projectName": "Financial Pulse",
    "endpoint": "https://fra.cloud.appwrite.io/v1",
    "sites": [
        {
            "$id": "financial-pulse",
            "name": "Financial Pulse",
            "enabled": true,
            "logging": true,
            "framework": "nextjs",
            "timeout": 30,
            "installCommand": "npm install",
            "buildCommand": "npm run build",
            "outputDirectory": ".next",
            "buildRuntime": "node-22",
            "adapter": "ssr",
            "path": "frontend"
        }
    ],
    "settings": {
        "services": {
            "account": true,
            "avatars": true,
            "databases": true,
            "locale": true,
            "health": true,
            "storage": true,
            "teams": true,
            "users": true,
            "sites": true,
            "functions": true,
            "graphql": true,
            "messaging": true
        },
        "protocols": {
            "rest": true,
            "graphql": true,
            "websocket": true
        },
        "auth": {
            "methods": {
                "jwt": true,
                "phone": true,
                "invites": true,
                "anonymous": true,
                "email-otp": true,
                "magic-url": true,
                "email-password": true
            },
            "security": {
                "duration": 31536000,
                "limit": 0,
                "sessionsLimit": 0,
                "passwordHistory": 0,
                "passwordDictionary": false,
                "personalDataCheck": false,
                "sessionAlerts": false,
                "mockNumbers": []
            }
        }
    },
    "tablesDB": [
        {
            "$id": "stock-dashboard",
            "name": "Stock Dashboard DB",
            "enabled": true
        }
    ],
    "tables": [
        {
            "$id": "volume_shockers",
            "$permissions": [],
            "databaseId": "stock-dashboard",
            "name": "Volume Shockers",
            "enabled": true,
            "rowSecurity": false,
            "columns": [
                {
                    "key": "symbol",
                    "type": "text",
                    "required": true,
                    "array": false,
                    "default": null,
                    "encrypt": false
                },
                {
                    "key": "name",
                    "type": "text",
                    "required": true,
                    "array": false,
                    "default": null,
                    "encrypt": false
                },
                {
                    "key": "price",
                    "type": "double",
                    "required": true,
                    "array": false,
                    "default": null,
                    "min": -1.7976931348623157e+308,
                    "max": 1.7976931348623157e+308
                },
                {
                    "key": "pct_change",
                    "type": "double",
                    "required": true,
                    "array": false,
                    "default": null,
                    "min": -1.7976931348623157e+308,
                    "max": 1.7976931348623157e+308
                },
                {
                    "key": "volume",
                    "type": "integer",
                    "required": true,
                    "array": false,
                    "default": null,
                    "min": -9223372036854775808,
                    "max": 9223372036854775807
                },
                {
                    "key": "avg_volume",
                    "type": "integer",
                    "required": true,
                    "array": false,
                    "default": null,
                    "min": -9223372036854775808,
                    "max": 9223372036854775807
                },
                {
                    "key": "multiplier",
                    "type": "double",
                    "required": true,
                    "array": false,
                    "default": null,
                    "min": -1.7976931348623157e+308,
                    "max": 1.7976931348623157e+308
                },
                {
                    "key": "sector",
                    "type": "text",
                    "required": true,
                    "array": false,
                    "default": null,
                    "encrypt": false
                }
            ],
            "indexes": []
        },
        {
            "$id": "investor_holdings",
            "$permissions": [],
            "databaseId": "stock-dashboard",
            "name": "Investor Holdings",
            "enabled": true,
            "rowSecurity": false,
            "columns": [
                {
                    "key": "investor_name",
                    "type": "text",
                    "required": true,
                    "array": false,
                    "default": null,
                    "encrypt": false
                },
                {
                    "key": "company_name",
                    "type": "text",
                    "required": true,
                    "array": false,
                    "default": null,
                    "encrypt": false
                },
                {
                    "key": "mcap_cr",
                    "type": "double",
                    "required": true,
                    "array": false,
                    "default": null,
                    "min": -1.7976931348623157e+308,
                    "max": 1.7976931348623157e+308
                },
                {
                    "key": "current_qtr_pct",
                    "type": "double",
                    "required": true,
                    "array": false,
                    "default": null,
                    "min": -1.7976931348623157e+308,
                    "max": 1.7976931348623157e+308
                },
                {
                    "key": "prev_qtr_pct",
                    "type": "double",
                    "required": true,
                    "array": false,
                    "default": null,
                    "min": -1.7976931348623157e+308,
                    "max": 1.7976931348623157e+308
                },
                {
                    "key": "report_date",
                    "type": "datetime",
                    "required": false,
                    "array": false,
                    "default": null,
                    "format": ""
                },
                {
                    "key": "is_increase",
                    "type": "boolean",
                    "required": true,
                    "array": false,
                    "default": null
                }
            ],
            "indexes": []
        },
        {
            "$id": "insider_trades",
            "$permissions": [],
            "databaseId": "stock-dashboard",
            "name": "Insider Trades",
            "enabled": true,
            "rowSecurity": false,
            "columns": [
                {
                    "key": "ticker",
                    "type": "text",
                    "required": true,
                    "array": false,
                    "default": null,
                    "encrypt": false
                },
                {
                    "key": "insider_name",
                    "type": "text",
                    "required": false,
                    "array": false,
                    "default": null,
                    "encrypt": false
                },
                {
                    "key": "insider_title",
                    "type": "text",
                    "required": true,
                    "array": false,
                    "default": null,
                    "encrypt": false
                },
                {
                    "key": "trade_type",
                    "type": "text",
                    "required": true,
                    "array": false,
                    "default": null,
                    "encrypt": false
                },
                {
                    "key": "shares",
                    "type": "integer",
                    "required": true,
                    "array": false,
                    "default": null,
                    "min": -9223372036854775808,
                    "max": 9223372036854775807
                },
                {
                    "key": "value_usd",
                    "type": "double",
                    "required": true,
                    "array": false,
                    "default": null,
                    "min": -1.7976931348623157e+308,
                    "max": 1.7976931348623157e+308
                },
                {
                    "key": "trade_date",
                    "type": "datetime",
                    "required": true,
                    "array": false,
                    "default": null,
                    "format": ""
                }
            ],
            "indexes": []
        }
    ]
}